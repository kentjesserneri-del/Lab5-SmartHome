CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_ESP_RMAKER_ASSISTED_CLAIM=y
CONFIG_APP_NETWORK_PROV_SHOW_QR=y
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_APP_PROV_SECURITY_VERSION_2=y
CONFIG_LOG_COLORS=n
